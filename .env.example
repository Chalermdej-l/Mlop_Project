# Copy to .env and fill in real values. .env is gitignored.
# Values must stay UNQUOTED: both `make -include .env` and docker-compose
# rely on plain KEY=value lines.

# --- AWS (IAM user with S3 + RDS access) ---
ACCESS_KEY=CHANGE_ME
ACCESS_SECRET=CHANGE_ME
AWS_DEFAULT_REGION=ap-southeast-1

# --- S3 buckets ---
# MLflow model artifacts
S3_BUCKET=CHANGE_ME
# Raw dataset (bank-additional-full.csv)
S3_BUCKET_DATA=CHANGE_ME

# --- RDS (AWS Postgres) ---
DB_NAME_ML=MLOP_Backend
DB_NAME_MONI=MONITOR_DB
AWS_USER_DB=CHANGE_ME
AWS_PASS_DB=CHANGE_ME

# --- Prefect Cloud ---
PREFECT_API_KEY=CHANGE_ME
# From https://app.prefect.cloud -> your account/workspace API settings
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/CHANGE_ME/workspaces/CHANGE_ME

# --- Grafana (http://localhost:3000) ---
GRAFANA_ADMIN_USER=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- MLflow ---
# Numeric MLflow experiment id of the "ML-xgb" experiment
# (see MLflow UI once `make dockerupmlserver` is running)
EXPERIMENT_ID=1

# The values below are generated at runtime into .env.local (gitignored),
# do not add them to .env:
#   DBS_ENDPOINT, AWS_DB_ML, AWS_DB_MONITOR  <- written by `make infra-prep`
#   RUN_ID                                   <- written by `make deploy-api`
